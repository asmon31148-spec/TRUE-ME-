# Public Client Configuration Only
# Private AI keys (GEMINI_API_KEY, GROQ_API_KEY, COHERE_API_KEY,
# OPENROUTER_API_KEY, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN)
# must be set exclusively in Supabase Edge Function Secrets for `ai-gateway`.

# Supabase (public URL & anon key protected by Row-Level Security)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Personal Cloud Vault (MEGA.nz Bridge Server URL)
MEGA_BRIDGE_URL=

# Google Drive OAuth Client ID (public client identifier)
GOOGLE_DRIVE_CLIENT_ID=
